# =============================================================================
# Single source of truth for the raab-analysis image build.
# Sourced by docker/gen-deps.sh and docker/build.sh (and mirrored by the CI
# workflow's IMAGE env). Keeping these here (not duplicated across the
# Dockerfile / scripts) prevents the lockfile and the image build from drifting.
# Bump these (and regenerate renv.lock + sysreqs.txt) for the ~yearly dep update.
# See docker/DL-2425-RAAB_IMAGE_CI_PLAN.md.
# =============================================================================

# OS/R base — multi-arch, PINNED BY DIGEST (rocker/r-ver:4.4.3, Ubuntu noble).
R_BASE="rocker/r-ver:4.4.3@sha256:3dae5d2eeddf74f10e0a81fb6b7ae350295e288000304f438b844b2c1e00fe2c"

# PPM snapshot date — amd64 reproducibility anchor (arm64 uses noble 'latest').
PPM_SNAPSHOT="2026-06-01"

# Human-readable image version: R line + snapshot. Production still pins the
# image by @sha256 digest — this tag is for humans.
IMAGE_VERSION="r4.4.3-${PPM_SNAPSHOT}"

# Single public GHCR image. Consumers pull credential-free; the CI workflow
# pushes here via GITHUB_TOKEN (packages: write). Override IMAGE for local test.
IMAGE="${IMAGE:-ghcr.io/raabteam/raab-analysis}"

# Target platforms. NOTE: buildx --load can't load a multi-arch manifest, so a
# local (PUSH=false) build must set a single platform; multi-arch requires PUSH=true.
PLATFORMS="${PLATFORMS:-linux/amd64,linux/arm64}"
