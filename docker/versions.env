# =============================================================================
# Single source of truth for the peek-raab image builds.
# Sourced by docker/gen-deps.sh, docker/build-base.sh, docker/build-code.sh.
# Keeping these here (not duplicated across Dockerfiles/scripts) prevents the
# lockfile and the image build from drifting. See docker/RENV_MIGRATION_PLAN.md.
# Bump these (and regenerate renv.lock + sysreqs.txt) for the ~yearly dep update.
# =============================================================================

# OS/R base — multi-arch, PINNED BY DIGEST (rocker/r-ver:4.4.3, Ubuntu noble).
R_BASE="rocker/r-ver:4.4.3@sha256:3dae5d2eeddf74f10e0a81fb6b7ae350295e288000304f438b844b2c1e00fe2c"

# PPM snapshot date — amd64 reproducibility anchor (arm64 uses noble 'latest').
PPM_SNAPSHOT="2026-06-01"

# TeXLive: the 'daily' TinyTeX bundle on both arches (no versioned arm64 bundle
# exists). Current TeXLive, consistent across arches; frozen by the image digest.
TEXLIVE_BUNDLE="daily"

# Human-readable base version: R line + snapshot. The code image still pins the
# base by @sha256 digest — this tag is for humans.
BASE_VERSION="r4.4.3-${PPM_SNAPSHOT}"

# Registries. Base is public ECR, code is private ECR (override for your account):
#   BASE_REPO=public.ecr.aws/<alias>/peek-raab-base
#   CODE_REPO=<acct>.dkr.ecr.<region>.amazonaws.com/peek-raab
BASE_REPO="${BASE_REPO:-peek-raab-base}"
CODE_REPO="${CODE_REPO:-peek-raab}"

# Target platforms. NOTE: buildx --load can't load a multi-arch manifest, so a
# local (PUSH=false) build must set a single platform; multi-arch requires PUSH=true.
PLATFORMS="${PLATFORMS:-linux/amd64,linux/arm64}"
